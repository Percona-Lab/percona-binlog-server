--source ../include/have_binsrv.inc

--source ../include/v80_v84_compatibility_defines.inc

--source include/count_sessions.inc

# The telemetry feature is independent of the storage backend, so this test
# runs with the default 'file' backend only.
--source ../include/identify_storage_backend.inc

--echo *** Setting up the Binlog Server utility environment with telemetry
--echo *** explicitly disabled and a short grace interval.
--let $binsrv_connect_timeout = 3
--let $binsrv_read_timeout = 3
--let $binsrv_idle_time = 1
--let $binsrv_verify_checksum = TRUE
--let $binsrv_replication_mode = position
--let $binsrv_telemetry_path = $MYSQL_TMP_DIR/telemetry_dir
--let $binsrv_telemetry_enabled = FALSE
--let $binsrv_telemetry_grace_interval = 2
--source ../include/set_up_binsrv_environment.inc

--mkdir $binsrv_telemetry_path

--echo
--echo *** Starting Binlog Server Utility in background in pull mode.
--let $proc_command_line = $BINSRV pull $binsrv_config_file_path > /dev/null
--source ../include/start_proc_in_background.inc

--echo
--echo *** Waiting well past the grace interval, then confirming that no
--echo *** telemetry report was written.
--sleep 5
--let $telemetry_listing = $MYSQL_TMP_DIR/telemetry_listing.txt
--list_files_write_file $telemetry_listing $binsrv_telemetry_path *.json
--let $read_from_file = $telemetry_listing
--source include/read_file_to_var.inc
if ($result != '')
{
  --die Telemetry is disabled but a report was written.
}
--remove_file $telemetry_listing

--echo
--echo *** Sending SIGTERM signal to the Binlog Server Utility and waiting for
--echo *** the process to terminate.
--source ../include/terminate_proc.inc

--echo
--echo *** Cleaning up.
--force-rmdir $binsrv_telemetry_path
--source ../include/tear_down_binsrv_environment.inc

--source ../include/kill_binlog_dump_connection.inc
--source include/wait_until_count_sessions.inc
