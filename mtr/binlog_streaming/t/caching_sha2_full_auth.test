# Exercises the caching_sha2_password full-authentication path (0x04) in the
# Binlog Server: RSA-OAEP over plain TCP, via both --get-server-public-key
# (client fetches the server PEM) and --server-public-key-path (client
# encrypts with a pre-loaded local PEM), plus one rejection case with a
# wrong password.
#
# PBS has no SHA-2 digest cache, so its authenticator treats every session
# as a cache miss and drives 0x04.
# That means the full-auth handshake this test verifies is the default
# path in binsrv.

# The Binlog Server listens on a hard-coded TCP port, so this test can not
# run in parallel with other tests using the same port.
--source include/not_parallel.inc

--source ../include/have_binsrv.inc

--source ../include/v80_v84_compatibility_defines.inc

--source include/count_sessions.inc

# in case of --repeat=N, we need to start from a fresh binary log to make
# this test deterministic
--echo *** Resetting replication at the very beginning of the test.
--disable_query_log
eval $stmt_reset_binary_logs_and_gtids;
--enable_query_log

# identifying backend storage type ('file' or 's3')
--source ../include/identify_storage_backend.inc

# creating data directory, configuration file, etc.
--let $binsrv_connect_timeout = 10
--let $binsrv_read_timeout = 10
--let $binsrv_idle_time = 1
--let $binsrv_verify_checksum = TRUE
--let $binsrv_replication_mode = position

# Server-side RSA key pair for the caching_sha2_password authenticator, fed
# to binsrv through the 'pbs_listener' config block that
# generate_binsrv_config.inc emits from these two vars. Both are required
# for 'pull'. The matching
# public key ships alongside as caching_sha2_full_auth_pubkey.pem so that
# scenario 2 below can also point mysql's --server-public-key-path at it.
--let $binsrv_pubkey_file  = $MYSQL_TEST_DIR/suite/binlog_streaming/std_data/caching_sha2_full_auth_pubkey.pem
--let $binsrv_privkey_file = $MYSQL_TEST_DIR/suite/binlog_streaming/std_data/caching_sha2_full_auth_privkey.pem
--let $binsrv_pbs_listener_rsa_public_key_path  = $binsrv_pubkey_file
--let $binsrv_pbs_listener_rsa_private_key_path = $binsrv_privkey_file
--source ../include/set_up_binsrv_environment.inc

--echo
--echo *** Starting Binlog Server Utility in background in pull mode.
--echo *** Because PBS has no digest cache, every login this binsrv
--echo *** sees will be driven through the 0x04 full-auth branch.
--echo *** stdout/stderr goes to a dedicated log so we can grep for auth
--echo *** markers AFTER binsrv has exited.
--let $binsrv_pid_file = $MYSQL_TMP_DIR/caching_sha2_full_auth_binsrv.pid
--let $binsrv_stdout_log = $MYSQL_TMP_DIR/caching_sha2_full_auth_binsrv_stdout.log
--let $binsrv_spawn_cmd_line = $BINSRV pull $binsrv_config_file_path > $binsrv_stdout_log 2>&1 & echo \$! > $binsrv_pid_file

# We route the spawn through Perl's system() rather than --exec because
# mysqltest strips the shell's `$!` before it can be expanded, leaving the
# PID file empty. Passing the command as an env var and executing it from
# Perl leaves the shell metacharacters intact.
--let EXPORTED_BINSRV_SPAWN_CMD_LINE = $binsrv_spawn_cmd_line
--perl
  use strict;
  use warnings;
  my $cmd = $ENV{'EXPORTED_BINSRV_SPAWN_CMD_LINE'};
  system("$cmd");
EOF

--let $read_from_file = $binsrv_pid_file
--source include/read_file_to_var.inc
--let $binsrv_pid = $result

# SELECT VERSION() is one of the queries the Binlog Server's command loop
# recognises (see network_service.cpp). Only the mysql client exit code is
# used as pass/fail; the row itself is discarded so the test stays stable
# across changes to the Binlog Server's hard-coded version string.
--let $probe_query = SELECT VERSION()

--echo
--echo *** Waiting for the Binlog Server listener to come up on
--echo *** 127.0.0.1:3307. We probe with bash's /dev/tcp instead of the
--echo *** mysql client because bash is not ASAN-instrumented and
--echo *** /dev/tcp uses a plain connect(2), so each attempt is cheap and
--echo *** measures exactly the "listening on the port" state we care
--echo *** about.
--let $max_wait = 300
--let $iteration = 0
--let $port_open = 0
while ($iteration < $max_wait)
{
  if (!$port_open)
  {
    --error 0, 1
    --exec bash -c "echo > /dev/tcp/127.0.0.1/3307" 2>/dev/null
    --let $port_status = $__error
    if ($port_status == 0)
    {
      --let $port_open = 1
      --let $iteration = $max_wait
    }
    if ($port_status != 0)
    {
      --sleep 1
      --inc $iteration
    }
  }
}
if (!$port_open)
{
  --die The Binlog Server listener did not become reachable on 3307 within 300 seconds
}

--echo
--echo *** Scenario 1: correct password + --get-server-public-key. Server
--echo *** sends 0x04 (PBS default), client requests the PEM
--echo *** with 0x02, server enqueues the RSA public key, client OAEP-
--echo *** encrypts the password and sends the ciphertext, server
--echo *** rsa_private_key::decrypt_oaep recovers it and matches. A zero
--echo *** exit code from mysql means the whole PEM + RSA round-trip
--echo *** succeeded.
--exec $MYSQL --protocol=TCP --host=127.0.0.1 --port=3307 --user=rpl --password=password --default-auth=caching_sha2_password --get-server-public-key --skip-column-names -e "$probe_query" >/dev/null 2>&1

--echo
--echo *** Scenario 2: correct password + --server-public-key-path pointing
--echo *** at the PEM we wrote above. Server sends 0x04, client skips the
--echo *** 0x02 PEM-fetch step and OAEP-encrypts the password directly with
--echo *** the local key, server decrypts and matches. Confirms
--echo *** rsa_private_key::decrypt_oaep and the ciphertext-length check
--echo *** in the wrapper agree with what mysql's client-side OAEP produces
--echo *** for this key.
--exec $MYSQL --protocol=TCP --host=127.0.0.1 --port=3307 --user=rpl --password=password --default-auth=caching_sha2_password --server-public-key-path=$binsrv_pubkey_file --skip-column-names -e "$probe_query" >/dev/null 2>&1

--echo
--echo *** Scenario 3: WRONG password + --get-server-public-key. Same full-
--echo *** auth handshake as scenario 1, but the RSA-decrypted plaintext no
--echo *** longer matches the configured password so
--echo *** verify_encrypted_password() returns failed and the server issues
--echo *** an access_denied. mysql exits non-zero, which we assert on to
--echo *** confirm the rejection path is graceful (no crash, no hang).
--error 1
--exec $MYSQL --protocol=TCP --host=127.0.0.1 --port=3307 --user=rpl --password=wrong-password --default-auth=caching_sha2_password --get-server-public-key --skip-column-names -e "$probe_query" >/dev/null 2>&1

--echo
--echo *** Sending SIGTERM to the Binlog Server Utility and waiting for the
--echo *** process to terminate (poll kill -0 until the pid is gone).
--echo *** Graceful exit flushes std::cout, so any log line binsrv wrote
--echo *** during its lifetime is now safely on disk.
--replace_result $binsrv_pid <BINSRV_PID>
--exec kill -s TERM $binsrv_pid

--let $max_exit_wait = 30
--let $iteration = 0
--let $binsrv_running = 1
while ($iteration < $max_exit_wait)
{
  if ($binsrv_running)
  {
    --error 0, 1
    --exec kill -0 $binsrv_pid 2>/dev/null
    --let $kill_status = $__error
    if ($kill_status != 0)
    {
      --let $binsrv_running = 0
      --let $iteration = $max_exit_wait
    }
    if ($kill_status == 0)
    {
      --sleep 1
      --inc $iteration
    }
  }
}
if ($binsrv_running)
{
  --die Binlog Server Utility did not terminate within 30 seconds
}

--echo
--echo *** Confirming end-to-end results by grepping the Binlog Server
--echo *** stdout log (now complete and flushed):
--echo ***   - "client authentication succeeded for rpl" proves at least one
--echo ***     full-auth session round-tripped correctly (scenarios 1 & 2)
--echo ***   - "client authentication failed for rpl" proves the rejection
--echo ***     path fired for the wrong-password session (scenario 3)
--let $grep_file = $binsrv_stdout_log
--let $grep_pattern = client authentication succeeded for rpl
--let $wait_timeout = 30
--source include/wait_for_pattern_in_file.inc

--let $grep_file = $binsrv_stdout_log
--let $grep_pattern = client authentication failed for rpl
--let $wait_timeout = 30
--source include/wait_for_pattern_in_file.inc

--remove_file $binsrv_pid_file
--remove_file $binsrv_stdout_log

# cleaning up
--source ../include/tear_down_binsrv_environment.inc

# As the Binlog Server Utility interrupts the connection upon timeout, here we
# need to close it on the MySQL server side as well in order to make sure that
# MTR 'check-test' before and after the test produces the same output.
--let $binlog_dump_connection_id = `SELECT ID FROM performance_schema.processlist WHERE COMMAND = 'Binlog Dump'`
--replace_result $binlog_dump_connection_id <CONNECTION_ID>
eval KILL CONNECTION $binlog_dump_connection_id;

# Also, we use 'count_sessions' include files to make sure that 'Binlog Dump'
# connection is indeed closed.
--source include/wait_until_count_sessions.inc
