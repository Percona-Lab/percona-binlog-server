--source ../include/have_binsrv.inc

--source ../include/v80_v84_compatibility_defines.inc

--source include/count_sessions.inc

# in case of --repeat=N, we need to start from a fresh binary log to make
# this test deterministic
--echo *** Resetting replication at the very beginning of the test.
--disable_query_log
eval $stmt_reset_binary_logs_and_gtids;
--enable_query_log

# identifying backend storage type ('file' or 's3')
--source ../include/identify_storage_backend.inc

# creating data directory, configuration file, etc.
--let $binsrv_connect_timeout = 10
--let $binsrv_read_timeout = 10
--let $binsrv_idle_time = 1
--let $binsrv_verify_checksum = TRUE
--let $binsrv_replication_mode = position
--source ../include/set_up_auth_rsa_keys.inc
--source ../include/set_up_binsrv_environment.inc

# SELECT VERSION() is one of the queries the Binlog Server's command loop
# recognises. We do not care what row comes back - we discard the client's
# stdout and rely solely on the mysql client's exit code as the pass/fail
# signal so the test stays stable when the Binlog Server's hard-coded
# version string changes.
--let $probe_query = SELECT VERSION()

# user name, password, RSA key and authentication plugin options are added
# for each combination individually (see
# rs_authentication_run_combinations.inc)
--let $mysql_client_base = $MYSQL --host=$binsrv_connection_host --port=$binsrv_replication_source_port

--echo
--echo *** Creating a table with all the authentication combinations.
# - state: whether the user has already successfully passed full
#   authentication at least once since the Binlog Server was started
#   ('authenticated') or not ('fresh')
# - user: 'valid' (the one from the Binlog Server configuration) or 'invalid'
# - password: 'valid' (the one from the Binlog Server configuration),
#   'invalid' or 'empty'
# - key_option: 'none', 'path' (--server-public-key-path) or 'get'
#   (--get-server-public-key)
# - plugin: 'matching' (client starts with caching_sha2_password advertised
#   by the Binlog Server) or 'switch' (client starts with
#   mysql_native_password, so the Binlog Server has to send an
#   AuthMethodSwitch)
CREATE TABLE auth_combinations(
  id INT UNSIGNED NOT NULL PRIMARY KEY,
  state ENUM('fresh', 'authenticated') NOT NULL,
  user ENUM('valid', 'invalid') NOT NULL,
  password ENUM('valid', 'invalid', 'empty') NOT NULL,
  key_option ENUM('none', 'path', 'get') NOT NULL,
  plugin ENUM('matching', 'switch') NOT NULL,
  expected_result BOOLEAN NOT NULL DEFAULT FALSE
);

--echo
--echo *** state: all state * user * password * key_option * plugin
--echo *** combinations.
# 'id' values are assigned explicitly (instead of relying on AUTO_INCREMENT)
# as InnoDB may leave gaps in AUTO_INCREMENT values for INSERT ... SELECT
INSERT INTO auth_combinations(id, state, user, password, key_option, plugin)
  SELECT ROW_NUMBER() OVER (ORDER BY s.o, u.o, p.o, k.o, pl.o),
    s.v, u.v, p.v, k.v, pl.v
  FROM (SELECT 1 AS o, 'fresh' AS v UNION ALL SELECT 2, 'authenticated') AS s
    CROSS JOIN (SELECT 1 AS o, 'valid' AS v UNION ALL SELECT 2, 'invalid') AS u
    CROSS JOIN (SELECT 1 AS o, 'valid' AS v UNION ALL SELECT 2, 'invalid' UNION ALL SELECT 3, 'empty') AS p
    CROSS JOIN (SELECT 1 AS o, 'none' AS v UNION ALL SELECT 2, 'path' UNION ALL SELECT 3, 'get') AS k
    CROSS JOIN (SELECT 1 AS o, 'matching' AS v UNION ALL SELECT 2, 'switch') AS pl;

--echo
--echo *** Marking the combinations expected to succeed.
# fresh state: full authentication is required, so the client must send the
# password itself, which (as the connection is not encrypted) is possible
# only if the client has the server's RSA public key (either via
# --server-public-key-path or --get-server-public-key) - the plugin does
# not matter as after the AuthMethodSwitch the client uses
# caching_sha2_password anyway
UPDATE auth_combinations SET expected_result = TRUE
  WHERE state = 'fresh' AND user = 'valid' AND password = 'valid' AND
        key_option IN ('path', 'get');
# authenticated state: the user is in the authentication cache, so the
# scramble is verified directly (fast authentication) and no RSA public key
# is needed - the plugin does not matter for the same reason as above
UPDATE auth_combinations SET expected_result = TRUE
  WHERE state = 'authenticated' AND user = 'valid' AND password = 'valid';

--echo
--echo *** Printing the full list of combinations.
SELECT * FROM auth_combinations ORDER BY id;

# a combination used to populate the authentication cache before executing
# 'authenticated' state combinations
--let $priming_combination_id = `SELECT MIN(id) FROM auth_combinations WHERE state = 'fresh' AND expected_result`

--let $proc_command_line = $BINSRV pull $binsrv_config_file_path > /dev/null
--let $listening_host = $binsrv_connection_host
--let $listening_port = $binsrv_replication_source_port

--echo
--echo *** Executing all the combinations that can be run within a single
--echo *** Binlog Server run.
--source ../include/start_proc_in_background.inc
--source ../include/wait_for_listening_port.inc

--echo
--echo *** 'fresh' state that is expected to fail (none of these attempts
--echo ***  will populate the authentication cache).
--let $combinations_condition = state = 'fresh' AND NOT expected_result
--source ../include/rs_authentication_run_combinations.inc

--echo
--echo *** Populating the authentication cache.
--let $combinations_condition = id = $priming_combination_id
--source ../include/rs_authentication_run_combinations.inc

--echo
--echo *** 'authenticated' state that is expected to succeed or fail
--echo ***  (none of these attempts will change the authentication cache).
--let $combinations_condition = state = 'authenticated'
--source ../include/rs_authentication_run_combinations.inc

--source ../include/terminate_proc.inc
--source ../include/kill_binlog_dump_connection.inc

--echo
--echo *** Executing every combination expected to succeed in the 'fresh'
--echo *** state within its own Binlog Server run (so that each one starts
--echo *** with an empty authentication cache).

--let $combinations_condition = state = 'fresh' AND expected_result
--let $combinations_restart_required = 1
--source ../include/rs_authentication_run_combinations.inc

--echo
--echo *** Dropping the table with the authentication combinations.
DROP TABLE auth_combinations;

# cleaning up
--source ../include/tear_down_binsrv_environment.inc

# Also, we use 'count_sessions' include files to make sure that 'Binlog Dump'
# connection is indeed closed.
--source include/wait_until_count_sessions.inc
