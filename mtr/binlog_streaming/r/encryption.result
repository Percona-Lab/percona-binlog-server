*** Executing the Binlog Server utility for the last time.

*** Executing the Binlog Server utility to produce the list
*** of binlog files along with their metadata.
include/read_file_to_var.inc
CREATE TABLE keyring_tbl AS
SELECT * FROM JSON_TABLE(
@keyring_keys_array,
'$[*]' COLUMNS(
id VARCHAR(32) PATH '$.id',
cipher VARCHAR(32) PATH '$.cipher',
data_hex VARCHAR(128) PATH '$.data_hex'
    )
) AS tt;
CREATE TABLE binlog_tbl AS
SELECT * FROM JSON_TABLE(
@parsed_list_result,
'$.result[*]' COLUMNS(
rowid FOR ORDINALITY,
name VARCHAR(32) PATH '$.name',
uri VARCHAR(128) PATH '$.uri',
kek_id VARCHAR(32) PATH '$.encryption.file_key_envelope.kek_id',
iv_for_file_key_encryption_hex VARCHAR(128) PATH '$.encryption.file_key_envelope.iv_hex',
file_key_encrypted_with_kek_hex VARCHAR(128) PATH '$.encryption.file_key_envelope.data_hex',
data_cipher VARCHAR(32) PATH '$.encryption.file_data_envelope.cipher',
iv_for_file_data_encryption VARCHAR(128) PATH '$.encryption.file_data_envelope.iv_hex'
    )
) AS tt;
